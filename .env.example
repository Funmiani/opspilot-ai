# Copy to .env and replace every placeholder with local development settings.
# Never use NEXT_PUBLIC_DATABASE_URL or commit a real connection string.
POSTGRES_DB=opspilot_dev
POSTGRES_USER=opspilot_dev
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL="postgresql://opspilot_dev:REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD@127.0.0.1:5432/opspilot_dev?schema=public"

# Required when using server authentication; generate a random secret locally.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
